# ================================================================ slides 15-16: Kalman filter on our data
def run_filter_on_ls1(seed=7):
    """Take the nominal LS1 trajectory, add our sensor noise, and filter it.
    Also run a fixed-alpha low-pass filter on the same measurements for comparison."""
    d = np.load("results/LS1_smcio.npz")
    r, v, a = d["r"], d["v"], d["a"]
    rng = np.random.default_rng(seed)
    z_r = r + rng.normal(0, MC.SIG_R, r.shape)
    z_v = v + rng.normal(0, MC.SIG_V, v.shape)
    kf = MC.NavFilter(z_r[0], z_v[0])
    est_v = np.zeros_like(v)
    est_v[0] = kf.update(z_r[0], z_v[0])[1]
    alpha = 0.9
    lpf_v = np.zeros_like(v)
    lpf_v[0] = z_v[0]
    for k in range(1, len(v)):
        kf.predict(a[k - 1])
        est_v[k] = kf.update(z_r[k], z_v[k])[1]
        lpf_v[k] = alpha * lpf_v[k - 1] + (1 - alpha) * z_v[k]
    return d["t"], v, z_v, est_v, lpf_v


def kalman_gains(n=12500):
    """Gain history of our filter (it does not depend on the data for a linear model)."""
    h = P.H
    A = np.array([[1, h], [0, 1]])
    H = np.eye(2)
    Q = 1e-3 ** 2 * np.array([[h**4 / 4, h**3 / 2], [h**3 / 2, h**2]])
    R = np.diag([MC.SIG_R**2, MC.SIG_V**2])
    Pk = R.copy()
    K = np.zeros((n, 2, 2))
    for k in range(n):
        if k > 0:
            Pk = A @ Pk @ A.T + Q                                 # P_k^- = A P_{k-1} A^T + Q
        K[k] = Pk @ H.T @ np.linalg.inv(H @ Pk @ H.T + R)        # K_k = P_k^- H^T (H P_k^- H^T + R)^-1
        Pk = Pk - K[k] @ H @ Pk                                   # P_k = P_k^- - K_k H P_k^-
    return np.arange(n) * h, K


def fig_kf():
    t, v, z, est, lpf = run_filter_on_ls1()
    w = (t >= 100) & (t <= 110)
    fig, ax = plt.subplots(figsize=(10, 3.7))
    ax.plot(t[w], z[w, 0], ".", color="0.6", markersize=4, label="measured (sensor noise σ = 1 cm/s)")
    ax.plot(t[w], lpf[w, 0], "-", color=MY, linewidth=1.4, label="low-pass filter, fixed α = 0.9")
    ax.plot(t[w], est[w, 0], "-", color=MB, linewidth=2.0, label="Kalman filter estimate")
    ax.plot(t[w], v[w, 0], "k--", linewidth=1.2, label="true velocity")
    ax.set_xlabel("time (s)"); ax.set_ylabel("v$_x$ (m/s)")
    ax.set_title("LS1: x-velocity seen by the guidance")
    ax.legend(loc="upper left", fontsize=12, ncol=2)
    fig.tight_layout()
    fig.savefig(OUT + "s15_kf_filtering.png")
    plt.close(fig)
    full = t > 5
    print("vx error std: raw %.4f  lpf %.4f  kf %.5f" % (np.std(z[full, 0] - v[full, 0]),
          np.std(lpf[full, 0] - v[full, 0]), np.std(est[full, 0] - v[full, 0])))

    tg, K = kalman_gains()
    fig, ax = plt.subplots(figsize=(12, 4.3))
    ax.semilogy(tg + P.H, K[:, 0, 0], "-", color=MB, linewidth=1.6, label="position gain  K$_r$")
    ax.semilogy(tg + P.H, K[:, 1, 1], "-", color=MO, linewidth=1.6, label="velocity gain  K$_v$")
    for tt in (0.0, 1.0, 10.0, 100.0):
        k = int(round(tt / P.H))
        ax.plot(tt + P.H, K[k, 0, 0], "s", color=MB, markersize=5)
        ax.plot(tt + P.H, K[k, 1, 1], "s", color=MO, markersize=5)
    ax.set_xscale("log")
    ax.set_xlabel("time since the filter started (s)")
    ax.set_ylabel("Kalman gain K$_k$  (α$_k$ = 1 − K$_k$)")
    ax.set_title("How much each new measurement is trusted")
    ax.legend(loc="lower left", fontsize=13)
    fig.tight_layout()
    fig.savefig(OUT + "s16_kf_gain.png")
    plt.close(fig)
    for tt in (0.0, 1.0, 10.0, 100.0, 600.0):
        k = int(round(tt / P.H))
        print(f"t={tt:6.1f}s  K_r={K[k,0,0]:.4f} alpha_r={1-K[k,0,0]:.4f}   K_v={K[k,1,1]:.4f} alpha_v={1-K[k,1,1]:.4f}")


# ================================================================ slide 16: the algorithm (Shane Ross / Phil Kim notation)
def fig_kf_loop():
    fig, ax = plt.subplots(figsize=(10, 8.6))
    ax.set_xlim(0, 12); ax.set_ylim(0, 10.6); ax.axis("off")
    box = dict(boxstyle="square,pad=0.6", facecolor="white", edgecolor="0.15", linewidth=1.0)
    steps = [
        (9.6, "0. Set initial values:   $\\hat{x}_0,\\ P_0$"),
        (7.6, "I. Predict state and error covariance:\n$\\hat{x}_k^- = A\\,\\hat{x}_{k-1} + B\\,u_{k-1}$\n$P_k^- = A\\,P_{k-1}A^T + Q$"),
        (5.3, "II. Compute the Kalman gain:\n$K_k = P_k^- H^T\\,(H P_k^- H^T + R)^{-1}$"),
        (3.1, "III. Compute the estimate:\n$\\hat{x}_k = \\hat{x}_k^- + K_k\\,(z_k - H\\,\\hat{x}_k^-)$"),
        (0.9, "IV. Compute the error covariance:\n$P_k = P_k^- - K_k H P_k^-$"),
    ]
    T = [ax.text(6, y, txt, ha="center", va="center", fontsize=19, bbox=box, linespacing=1.5) for y, txt in steps]
    fig.tight_layout()
    fig.canvas.draw()
    inv = ax.transData.inverted()
    E = []
    for t in T:
        bb = t.get_bbox_patch().get_window_extent()
        (x0, y0), (x1, y1) = inv.transform([[bb.x0, bb.y0], [bb.x1, bb.y1]])
        E.append((x0, y0, x1, y1))
    arr = lambda p, q, c="k", st="-|>": ax.annotate("", xy=q, xytext=p, arrowprops=dict(arrowstyle=st, color=c, lw=1.3, shrinkA=0, shrinkB=0))
    for i in range(4):
        arr((6, E[i][1]), (6, E[i + 1][3]))
    xr = max(e[2] for e in E) + 2.1
    ymid = lambda e: (e[1] + e[3]) / 2
    arr((E[4][2], ymid(E[4])), (xr, ymid(E[4])), st="-")
    arr((xr, ymid(E[4])), (xr, ymid(E[1])), st="-")
    arr((xr, ymid(E[1])), (E[1][2], ymid(E[1])))
    ax.text(xr + 0.15, (ymid(E[1]) + ymid(E[4])) / 2, "next step\n$k \\leftarrow k+1$", fontsize=14, va="center")
    arr((0.2, ymid(E[3])), (E[3][0], ymid(E[3])), c=MO)
    ax.text(0.2, ymid(E[3]) + 0.3, "measurement $z_k$", fontsize=14, color=MO)
    arr((E[3][2], ymid(E[3]) - 0.25), (xr - 0.25, ymid(E[3]) - 0.25), c=MB)
    ax.text(E[3][2] + 0.05, ymid(E[3]) - 0.75, "estimate $\\hat{x}_k$ \u2192 guidance", fontsize=14, color=MB)
    fig.savefig(OUT + "s16_kf_loop.png", bbox_inches="tight")
    plt.close(fig)


