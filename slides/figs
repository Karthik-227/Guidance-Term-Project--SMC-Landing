def mboxplot(ax, data, labels):
    """MATLAB-style boxplot: blue box, red median, dashed black whiskers, red + outliers."""
    b = ax.boxplot(data, widths=0.5, patch_artist=False,
                   boxprops=dict(color=MB, linewidth=1), medianprops=dict(color="r", linewidth=1),
                   whiskerprops=dict(color="k", linestyle="--", linewidth=0.8),
                   capprops=dict(color="k", linewidth=0.8),
                   flierprops=dict(marker="+", markeredgecolor="r", markersize=6))
    ax.set_xticks(range(1, len(labels) + 1))
    ax.set_xticklabels(labels)
    return b


