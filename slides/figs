    a.legend(loc="upper right", fontsize=13)

    b = ax[1]
    names = list(P.CASES)
    old = np.array([grad_U(P.CASES[n]["rfd"]) @ P.CASES[n]["rfd"] / np.linalg.norm(P.CASES[n]["rfd"]) for n in names])
    new = np.array([grad_exact(P.CASES[n]["rfd"]) @ P.CASES[n]["rfd"] / np.linalg.norm(P.CASES[n]["rfd"]) for n in names])
