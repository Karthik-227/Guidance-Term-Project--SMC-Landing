    b.annotate(f"+{old[-1]*s:.0f} (off scale)\npoints OUTWARD", xy=(6 - 0.2, 12), xytext=(3.2, 9.5),
               fontsize=13, arrowprops=dict(arrowstyle="->", color="k", lw=0.8))
    b.set_xticks(x); b.set_xticklabels(names)
    b.set_ylim(-25, 14)
    b.set_ylabel("radial gravity  (×10$^{-4}$ m/s$^2$),  < 0 = inward")
    b.set_title("Radial gravity at the landing sites")
    b.legend(loc="lower left", fontsize=13)
    fig.tight_layout()
    fig.savefig(OUT + "s10_gravity_models.png")
    plt.close(fig)
    print("radial g old:", np.round(old, 6), "\nradial g new:", np.round(new, 6))


